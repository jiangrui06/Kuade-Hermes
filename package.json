    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.3",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
