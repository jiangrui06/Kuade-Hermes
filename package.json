{
  "name": "kuade-desktop",
  "version": "0.2.4",
  "private": true,
  "description": "Kuade Harness — a local coding workspace",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:computer": "node scripts/build-computer.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/acceptance/github-evidence.test.mjs scripts/acceptance/soak-gate.test.mjs scripts/acceptance/project-manager-verify.test.mjs scripts/acceptance/session-observation.test.mjs scripts/acceptance/session-history.test.mjs",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
